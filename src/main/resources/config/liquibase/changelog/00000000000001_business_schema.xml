    <changeSet id="00000000000010" author="quanly-email">
        <sql dbms="mysql" splitStatements="true" stripComments="true">
            INSERT INTO users (user_name, pass_word, full_name, email, status)
            SELECT 'tienthanh11042003@gmail.com', 'GOOGLE_LOGIN_ONLY', 'Thanh Tien', 'tienthanh11042003@gmail.com', TRUE
            WHERE NOT EXISTS (
                SELECT 1 FROM users WHERE LOWER(email) = LOWER('tienthanh11042003@gmail.com')
            );

            INSERT INTO role (name, description)
            SELECT 'ADMIN', 'Quản trị viên hệ thống'
            WHERE NOT EXISTS (
                SELECT 1 FROM role WHERE name = 'ADMIN'
            );

            INSERT INTO user_roles (user_id, role_id)
            SELECT u.id, r.id
            FROM users u
            CROSS JOIN role r
            WHERE LOWER(u.email) = LOWER('tienthanh11042003@gmail.com')
              AND r.name = 'ADMIN'
              AND NOT EXISTS (
                  SELECT 1 FROM user_roles ur
                  WHERE ur.user_id = u.id AND ur.role_id = r.id
              );
        </sql>
    </changeSet>

